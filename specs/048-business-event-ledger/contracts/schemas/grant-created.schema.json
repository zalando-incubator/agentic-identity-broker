{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-identity-broker:events:v1:grant-created",
  "title": "grant-created",
  "description": "A new user-to-agent delegation is committed.",
  "allOf": [
    {
      "$ref": "urn:agentic-identity-broker:events:v1:envelope"
    },
    {
      "properties": {
        "type": {
          "const": "agentic-identity-broker.grant-created"
        },
        "outcome": {
          "const": "success"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "grant_id",
        "agent_id"
      ]
    }
  ]
}
