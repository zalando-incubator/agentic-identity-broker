{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-identity-broker:events:v1:token-exchange-denied",
  "title": "token-exchange-denied",
  "description": "An exchange is refused by authentication or authorization controls.",
  "allOf": [
    {
      "$ref": "urn:agentic-identity-broker:events:v1:envelope"
    },
    {
      "properties": {
        "type": {
          "const": "agentic-identity-broker.token-exchange-denied"
        },
        "outcome": {
          "const": "denied"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason_code": {
              "enum": [
                "invalid_request",
                "authentication_failed",
                "authorization_failed"
              ]
            }
          },
          "required": [
            "reason_code"
          ]
        }
      }
    }
  ]
}
