{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-identity-broker:events:v1:token-exchanged",
  "title": "token-exchanged",
  "description": "The broker completes a token exchange for a receiving agent.",
  "allOf": [
    {
      "$ref": "urn:agentic-identity-broker:events:v1:envelope"
    },
    {
      "properties": {
        "type": {
          "const": "agentic-identity-broker.token-exchanged"
        },
        "outcome": {
          "const": "success"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "agent_id"
      ]
    }
  ]
}
