# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
dist/
build/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Environment files
.env*
!.env*.example

# Editor/IDE
# .idea/
# .vscode/

# Node.js / Docusaurus
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js
assets/docusaurus/build/
assets/docusaurus/.docusaurus/
assets/docusaurus/.cache-loader/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp
.DS_Store
Thumbs.db

.playwright-mcp
bin/identity-broker
identity-broker

test-results
tmp

.worktrees
/agentic-identity-broker

tests/e2e/frontend/coverage/

infra/cdk/cdk
infra/cdk/cdk.out
/bin/extproc-token-exchange
/mocks/mcp-server/mcp-server
/tools/imgdiff/imgdiff
