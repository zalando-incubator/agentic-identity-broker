{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-identity-broker:events:v1:credential-revoked",
  "title": "credential-revoked",
  "description": "An agent credential is revoked.",
  "allOf": [
    {
      "$ref": "urn:agentic-identity-broker:events:v1:envelope"
    },
    {
      "properties": {
        "type": {
          "const": "agentic-identity-broker.credential-revoked"
        },
        "outcome": {
          "const": "success"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credential_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "credential_id"
          ]
        }
      },
      "required": [
        "agent_id"
      ]
    }
  ]
}
