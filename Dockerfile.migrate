# Agentic Identity Broker - Migration Docker Image
# This Dockerfile packages only the golang-migrate tool and migration files
# Used exclusively by Kubernetes migration Jobs with schema-level permissions
ARG BASE_IMAGE=default
FROM alpine:3 AS default
FROM ${BASE_IMAGE}

# Build arguments for multi-architecture support via docker buildx
# When using: docker buildx build --platform linux/amd64,linux/arm64 ...
# TARGETARCH is automatically set to: amd64, arm64, etc.
ARG TARGETARCH

ARG VERSION
ARG REVISION
ARG CREATED

LABEL org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.title="Agentic Identity Broker - Migrations" \
      org.opencontainers.image.description="Database migration tool for Agentic Identity Broker (golang-migrate)" \
      org.opencontainers.image.vendor="Zalando SE" \
      org.opencontainers.image.authors="Magnus Jungsbluth <magnus.jungsbluth@zalando.de>, Jan Brennenstuhl <jan.brennenstuhl@zalando.de>" \
      org.opencontainers.image.url="https://github.com/zalando-incubator/agentic-identity-broker" \
      org.opencontainers.image.documentation="https://github.com/zalando-incubator/agentic-identity-broker#readme" \
      org.opencontainers.image.source="https://github.com/zalando-incubator/agentic-identity-broker" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

# golang-migrate version for database migrations
ARG MIGRATE_VERSION=v4.17.0

# Create non-root user for security (uid=1000, gid=1000)
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

# Set working directory
WORKDIR /app

# Install golang-migrate for database migrations
# This image is used ONLY by Kubernetes migration Jobs with schema-level permissions
RUN apk add --no-cache curl ca-certificates && \
    curl -L "https://github.com/golang-migrate/migrate/releases/download/${MIGRATE_VERSION}/migrate.linux-${TARGETARCH}.tar.gz" | tar xvz && \
    mv migrate /usr/local/bin/migrate && \
    chmod +x /usr/local/bin/migrate && \
    apk del curl && \
    rm -rf /var/cache/apk/*

# Copy database migration files only
# Application binary and frontend assets are NOT included
COPY --chown=1000:1000 ./migrations /app/migrations

# Switch to non-root user for container execution
USER 1000:1000

# Migration-specific entrypoint
ENTRYPOINT ["/usr/local/bin/migrate"]

# Default help command (override with actual migration args in Kubernetes Job)
CMD ["-help"]
