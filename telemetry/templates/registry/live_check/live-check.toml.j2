# Settings of `weaver registry live-check` for the CI jobs and `just telemetry-live-check`.
# Generated from telemetry/registry. Do not edit. Run `just telemetry-doc`.

[registry]
v2 = true

# The checks that Weaver does not have built in. The path starts at the repository root.
[live-check]
advice_policies = "telemetry/policies"

# A value that an enumerated attribute does not list is a violation.
[[live-check.finding_level_overrides]]
ids = ["undefined_enum_variant"]
level = "violation"

# Each registry entry has stability `development`, and the registry does not say which
# attributes are always set.
[[live-check.finding_filters]]
exclude = ["not_stable", "recommended_attribute_not_present"]

# A span has no identifier but its name. Each matcher pairs a span name with its definition.
{% for s in ctx.spans | sort(attribute="type") %}

[[live-check.matchers]]
id = "span.{{ s.type }}"
sample_type = "span"
when = 'name == "{{ s.type }}"'
signal = "{{ s.type }}"
{% endfor %}
