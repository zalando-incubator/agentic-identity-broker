# Multi-stage Dockerfile for mock OAuth2 servers
# Used for: upstream-oauth2-server, third-party-oauth2-server, sample-agent
# Accepts SERVICE_PATH build argument to specify which service to build

# Builder stage: compile Go binary
FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Copy go module files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy full source
COPY . .

# Build binary from specified service
# SERVICE_PATH should be relative path like: mocks/upstream-oauth2-server/cmd/mock-upstream-oauth2-server
# Extract service base directory (everything up to /cmd)
ARG SERVICE_PATH
RUN set -ex && \
    SERVICE_BASE=$(echo "${SERVICE_PATH}" | sed 's|/cmd/.*||') && \
    cd "$SERVICE_BASE" && \
    CMD_PATH=$(echo "${SERVICE_PATH}" | sed "s|^${SERVICE_BASE}/||") && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /tmp/mock-service "${CMD_PATH}/main.go"

# Runtime stage: minimal image with binary and config
FROM alpine:latest@sha256:5b02b42e375f7426f8d65c3af331ca05d9878f9989230354504e0b9dfd431f60

WORKDIR /app

# Install ca-certificates (curl installed by docker-compose healthchecks)
RUN apk add --no-cache ca-certificates curl

# Copy compiled binary from builder
COPY --from=builder /tmp/mock-service .

# Note: config.yaml is provided by docker-compose via volume mount
# Each service gets its specific config mounted at runtime:
#   - upstream-oauth2: ./mocks/upstream-oauth2-server/config.yaml:/app/config.yaml
#   - third-party-oauth2: ./mocks/third-party-service/config.yaml:/app/config.yaml
#   - sample-agent: ./mocks/sample-agent/config.yaml:/app/config.yaml

# Run the service
CMD ["./mock-service"]
