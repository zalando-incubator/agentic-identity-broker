# Docker Compose Development Environment
# Run just compose-env to copy this template to .env.compose.

# Optional PostgreSQL settings are used by:
# `just compose-up postgres` and `just compose-up-detached postgres`.


# Backend Configuration
IDENTITY_BROKER_LOG_LEVEL=debug
IDENTITY_BROKER_LOG_FORMAT=text
IDENTITY_BROKER_STATE_TOKEN_TTL=10m
IDENTITY_BROKER_PKCE_VERIFIER_LENGTH=32
IDENTITY_BROKER_STORAGE_BACKEND=memory
IDENTITY_BROKER_POSTGRES_DB=agentic_identity_broker
IDENTITY_BROKER_POSTGRES_USER=aib_dev
IDENTITY_BROKER_POSTGRES_PASSWORD=aib_dev_password
IDENTITY_BROKER_POSTGRES_HOST_PORT=5433

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_LOG_LEVEL=debug

# Seed Scripts (use container DNS names inside compose network)
ADMIN_API=http://identity-broker:14000/api
BROKER_HEALTH_URL=http://identity-broker:14000/health
MOCK_SERVER_URL=http://third-party-oauth2:9000

# Container Runtime
DOCKER_BUILDKIT=1
COMPOSE_HTTP_TIMEOUT=300
