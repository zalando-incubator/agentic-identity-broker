# Patterns to ignore when building packages
# This file supports shell glob matching, relative path matching, and negation
# (prefixed with !). Only one pattern per line.

.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# CI/CD
.github/
.gitlab-ci.yml
# Documentation and tests
README.md.gotmpl
CONTRIBUTING.md
LICENSE
docs/
examples/
*.test.yaml
*.secret.yaml
secrets/
.kube/
kubeconfig*
*.key
*.crt
