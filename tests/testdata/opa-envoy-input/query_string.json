{
  "name": "query_string",
  "request": {
    "method": "POST",
    "path": "/oauth2/token",
    "raw_query": "trace=1&tag=a&tag=b",
    "headers": {"content-type": "application/x-www-form-urlencoded"}
  },
  "expected": {
    "attributes.request.http": {
      "method": "POST",
      "headers": {"content-type": "application/x-www-form-urlencoded"}
