# Docker Compose Development Environment
# This file is separate from .env for Git safety
# Copy from .env if you need to customize: cp .env .env.compose

# Runtime-generated per `just compose-up*`; left blank here so Compose parsing stays quiet.
IDENTITY_BROKER_JWE_SIGNING_KEY=
IDENTITY_BROKER_ENCRYPTION_MEMORY_RAW_KEY=


# Backend Configuration
IDENTITY_BROKER_LOG_LEVEL=debug
IDENTITY_BROKER_LOG_FORMAT=text
IDENTITY_BROKER_STATE_TOKEN_TTL=10m
IDENTITY_BROKER_PKCE_VERIFIER_LENGTH=32
IDENTITY_BROKER_STORAGE_BACKEND=memory

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_LOG_LEVEL=debug

# Seed Scripts (use container DNS names inside compose network)
ADMIN_API=http://identity-broker:14000/api
BROKER_HEALTH_URL=http://identity-broker:14000/health
MOCK_SERVER_URL=http://third-party-oauth2:9000

# Container Runtime
DOCKER_BUILDKIT=1
COMPOSE_HTTP_TIMEOUT=300
