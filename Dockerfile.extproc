# Dockerfile for the ExtProc Token Exchange Service.
# Docker Compose builds the development stage from source. Release builds package
# the precompiled target-specific artifact.
# BASE_IMAGE must be declared before the first FROM (global ARG scope) to be
# usable in the runtime stage's FROM below. It lets internal release
# pipelines override the public default with an internally-mirrored/allowed
# base image (see delivery.yaml).
ARG BASE_IMAGE=alpine:3@sha256:5b02b42e375f7426f8d65c3af331ca05d9878f9989230354504e0b9dfd431f60

FROM --platform=$BUILDPLATFORM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS development-builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app
ENV GOEXPERIMENT=jsonv2

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags="-s -w" \
    -o /tmp/extproc-token-exchange \
    ./cmd/extproc-token-exchange

FROM alpine:3@sha256:5b02b42e375f7426f8d65c3af331ca05d9878f9989230354504e0b9dfd431f60 AS development

WORKDIR /app

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

RUN apk add --no-cache ca-certificates

COPY --chown=1000:1000 --from=development-builder /tmp/extproc-token-exchange /app/extproc-token-exchange

EXPOSE 50051

USER 1000:1000
CMD ["./extproc-token-exchange"]

# BASE_IMAGE lets internal release pipelines override the public default
# with an internally-mirrored/allowed base image (see delivery.yaml).
FROM ${BASE_IMAGE} AS runtime

ARG VERSION
ARG REVISION
ARG CREATED

LABEL org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.title="Agentic Identity Broker - ExtProc Token Exchange" \
      org.opencontainers.image.description="Envoy External Processing service for transparent Bearer token exchange" \
      org.opencontainers.image.vendor="Zalando SE" \
      org.opencontainers.image.authors="Magnus Jungsbluth <magnus.jungsbluth@zalando.de>, Jan Brennenstuhl <jan.brennenstuhl@zalando.de>" \
      org.opencontainers.image.url="https://github.com/zalando-incubator/agentic-identity-broker" \
      org.opencontainers.image.documentation="https://github.com/zalando-incubator/agentic-identity-broker#readme" \
      org.opencontainers.image.source="https://github.com/zalando-incubator/agentic-identity-broker" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app

RUN apk add --no-cache ca-certificates

EXPOSE 50051

USER 1000:1000

ARG TARGETARCH

COPY --chown=1000:1000 ./bin/linux/${TARGETARCH}/extproc-token-exchange /app/extproc-token-exchange
CMD ["./extproc-token-exchange"]
