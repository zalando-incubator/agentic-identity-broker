# Development Dockerfile for frontend (React + Vite)
# Enables Hot Module Replacement (HMR) during development
# Built for use with docker-compose volume mounts

FROM node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy package files for dependency caching
COPY web/package.json web/package-lock.json ./

# Install dependencies
RUN npm ci

# Copy entire web directory (excluding node_modules which npm ci already installed)
# NOTE: In development, docker-compose.yml mounts ./web:/app to override this for hot reload
# This COPY includes all config files: vite, tailwind, vitest, tsconfig, storybook, etc.
COPY web/ ./

# Expose port 3000 for Vite dev server
EXPOSE 3000

# Run Vite dev server with host binding (required for container)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
