FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY mocks/cimd-server/go.mod ./
RUN go mod download

COPY mocks/cimd-server/ .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /tmp/cimd-server ./cmd/cimd-server

FROM alpine:latest@sha256:5b02b42e375f7426f8d65c3af331ca05d9878f9989230354504e0b9dfd431f60

WORKDIR /app

RUN apk add --no-cache ca-certificates curl

COPY --from=builder /tmp/cimd-server .

CMD ["./cimd-server"]
