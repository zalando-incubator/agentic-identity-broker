FROM golang:1.27.3-alpine@sha256:d530cf60723abf1ffae0cd16bb546b379ec0550d2f3815e5b16ed69dbc00fba4 AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY mocks/cimd-server/go.mod ./
RUN go mod download

COPY mocks/cimd-server/ .

ARG LDFLAGS="-s -w"

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="${LDFLAGS}" -o /tmp/cimd-server ./cmd/cimd-server

FROM alpine:latest@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

WORKDIR /app

RUN apk add --no-cache ca-certificates curl

COPY --from=builder /tmp/cimd-server .

CMD ["./cimd-server"]
